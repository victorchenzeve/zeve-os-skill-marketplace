{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zewei skills registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "skills"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "description",
          "version",
          "path",
          "maturity",
          "status",
          "category",
          "tags"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "maturity": {
            "enum": [
              "draft",
              "experimental",
              "stable",
              "deprecated"
            ]
          },
          "status": {
            "enum": [
              "active",
              "archived"
            ]
          },
          "category": {
            "enum": [
              "core",
              "private-domain",
              "business",
              "content",
              "knowledge",
              "research"
            ]
          },
          "tags": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    }
  }
}
