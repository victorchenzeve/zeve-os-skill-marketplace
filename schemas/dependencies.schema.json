{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Zewei dependencies registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dependencies"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from",
          "to",
          "reason"
        ],
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^(skill|plugin|agent):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "to": {
            "type": "string",
            "pattern": "^(skill|plugin|agent):[a-z][a-z0-9]*(?:-[a-z0-9]+)*$"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
