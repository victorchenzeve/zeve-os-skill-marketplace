{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Read-only skill inventory snapshot",
  "type": "object",
  "required": [
    "schemaVersion",
    "snapshotId",
    "records"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "snapshotId": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "recordId",
          "name",
          "baseName",
          "description",
          "sourcePath",
          "scanRoot",
          "sha256",
          "bytes",
          "modifiedAt",
          "installedLocationOrRuntime",
          "templateCandidate",
          "runtime",
          "provenance",
          "localCreation",
          "standardsObserved",
          "issues",
          "governanceStatus",
          "registryId",
          "maturity",
          "dependencyAssessment",
          "behaviorEvaluation"
        ],
        "properties": {
          "recordId": {
            "type": "string",
            "pattern": "^inv-[a-f0-9]{16}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "baseName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sourcePath": {
            "type": "string",
            "pattern": "^%[A-Z_0-9]+%/"
          },
          "scanRoot": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "number"
          },
          "modifiedAt": {
            "type": "string"
          },
          "installedLocationOrRuntime": {
            "type": "boolean"
          },
          "templateCandidate": {
            "type": "boolean"
          },
          "runtime": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "contextId",
                "enabled",
                "scope"
              ],
              "properties": {
                "contextId": {
                  "type": "string"
                },
                "enabled": {
                  "type": "boolean"
                },
                "scope": {
                  "type": "string"
                }
              },
              "additionalProperties": true
            }
          },
          "provenance": {
            "type": "object",
            "required": [
              "classification",
              "verifiedOriginalAuthor"
            ],
            "properties": {
              "classification": {
                "type": "string"
              },
              "verifiedOriginalAuthor": {
                "const": false
              }
            },
            "additionalProperties": true
          },
          "localCreation": {
            "type": "object",
            "required": [
              "status"
            ],
            "properties": {
              "status": {
                "enum": [
                  "derived-generation-evidence",
                  "zewei-related-candidate",
                  "local-artifact-authorship-unverified",
                  "unverified"
                ]
              }
            },
            "additionalProperties": true
          },
          "standardsObserved": {
            "type": "object"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "governanceStatus": {
            "const": "pending-review"
          },
          "registryId": {
            "const": null
          },
          "maturity": {
            "const": null
          },
          "dependencyAssessment": {
            "const": "not-executed"
          },
          "behaviorEvaluation": {
            "const": "not-executed"
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
